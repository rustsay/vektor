# Любая OpenAI-совместимая модель. Без этих переменных агенты работают в офлайн-режиме (на правилах).
# Пример для Ollama на этой же машине (из Docker):  http://host.docker.internal:11434/v1
VEKTOR_LLM_BASE_URL=
VEKTOR_LLM_API_KEY=
VEKTOR_LLM_MODEL=

# Сервисный ключ VK — нужен только для анализа сообществ VK (vk.com/apps?act=manage)
VK_SERVICE_TOKEN=
